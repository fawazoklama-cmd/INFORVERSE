# GEMINI_API_KEY: Required for server-side Gemini AI summarization, translation, and content analysis.
# Configure via Settings -> Secrets in AI Studio, Firebase Functions Secrets, or Vercel Environment Variables.
GEMINI_API_KEY=

# APP_URL: Public base URL of your deployed application (used for sitemap, RSS, canonical URLs).
APP_URL=

# NEWS_API_KEY: Optional NewsAPI.org / GNews API key for automated news collection.
NEWS_API_KEY=

# CRON_SECRET: Secret token required in Authorization / x-cron-secret header for scheduled / HTTP collection triggers.
CRON_SECRET=

# VITE_FIREBASE_APPCHECK_SITE_KEY: Optional Google reCAPTCHA v3 site key to enable Firebase App Check in the browser.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# NEWSLETTER_ENABLED: Set to "true" when an email service (e.g. Resend/SMTP) is configured.
NEWSLETTER_ENABLED=false
