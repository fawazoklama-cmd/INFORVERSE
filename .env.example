# GEMINI_API_KEY: Required for server-side Gemini AI summarization, translation, and content analysis.
# Configure via Settings -> Secrets in AI Studio or Vercel Environment Variables.
GEMINI_API_KEY=

# APP_URL: Public base URL of your deployed application (used for sitemap, RSS, canonical URLs).
APP_URL=

# SUPABASE_URL: Your Supabase project URL (e.g., https://xyzcompany.supabase.co).
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY: Server-only Supabase Service Role key (NEVER expose to frontend).
SUPABASE_SERVICE_ROLE_KEY=

# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY: Optional public Supabase client config for browser auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# NEWS_API_KEY: Optional NewsAPI.org / GNews API key for automated news collection.
NEWS_API_KEY=

# CRON_SECRET: Secret token required in Authorization / x-cron-secret header for /api/cron/collect.
CRON_SECRET=

# ADMIN_EMAIL & ADMIN_PASSWORD: Optional pre-configured admin credentials (if unset, first-run claim setup is shown).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SESSION_SECRET: Optional secret key for signing server admin session tokens.
SESSION_SECRET=

# NEWSLETTER_ENABLED: Set to "true" when an email service (e.g. Resend/SMTP) is configured.
NEWSLETTER_ENABLED=false
